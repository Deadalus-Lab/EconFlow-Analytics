{
  "name": "df-label-greek",
  "why": "data.frame with a TEXT column in Greek (UTF-8) + NA in a numeric one",
  "producer": ".node_ptr_serialize",
  "format": "parquet",
  "engine": {
    "arrow_version": "24.0.0"
  },
  "sidecar": {
    "class": "data.frame",
    "ts": false,
    "columns": [
      "χώρα",
      "ΑΕΠ"
    ]
  },
  "expect": {
    "kind": "data.frame",
    "columns": [
      {
        "name": "χώρα",
        "type": "character",
        "values": [
          "Ελλάδα",
          "Γερμανία",
          "Γαλλία"
        ]
      },
      {
        "name": "ΑΕΠ",
        "type": "numeric",
        "values": [
          "1.5",
          "3.5",
          null
        ],
        "na": [
          2
        ]
      }
    ],
    "na": []
  }
}
