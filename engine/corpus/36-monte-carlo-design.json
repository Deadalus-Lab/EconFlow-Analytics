{
 "category": "36-monte-carlo-design",
 "cards": [
  {
   "id": 309,
   "method": "Data-generating-process simulators for ARMA, VAR, GARCH, panel and factor models",
   "wrapper_file": "c36_monte_carlo_design/dgp_simulators.py",
   "tool_fns": [
    "mc_simulate_arma",
    "mc_simulate_var",
    "mc_simulate_garch",
    "mc_simulate_panel"
   ],
   "when": "you need data with known properties to check an estimator, size a study or demonstrate a method",
   "when_not": "you have real data and no need for a controlled experiment",
   "alternatives": [
    {
     "alt": "bootstrap from real data",
     "criterion": "you want realism rather than a known truth"
    },
    {
     "alt": "parametric simulation",
     "criterion": "the truth must be known exactly"
    },
    {
     "alt": "agent-based simulation",
     "criterion": "the process is not describable in closed form"
    }
   ],
   "output_key_fields": [
    "simulated: the generated data",
    "true_params: the parameters used, so an estimator can be scored against them",
    "seed: the seed, without which nothing here is reproducible"
   ],
   "chart_kind": "multi-line",
   "interpretation_traps": [
    "the burn-in must be long enough for the process to reach stationarity, or the first observations carry the initial condition",
    "a simulated series is only as informative as the process is realistic; a study on a well-behaved ARMA says nothing about a break-ridden real series",
    "reusing one seed across designs makes results correlated in ways that look like findings"
   ],
   "sources": [
    "Hamilton 1994, Time Series Analysis",
    "Lutkepohl 2005, New Introduction to Multiple Time Series Analysis",
    "statsmodels"
   ],
   "precondition_tools": null,
   "precondition_gates": null,
   "validation_notes": null
  },
  {
   "id": 310,
   "method": "Size and power studies with rejection frequencies",
   "wrapper_file": "c36_monte_carlo_design/size_power.py",
   "tool_fns": [
    "mc_size_study",
    "mc_power_study"
   ],
   "when": "quantifying whether a test actually holds its nominal level and how often it detects a given alternative, before it is used on real data",
   "when_not": "the test is standard and its properties in your design are already documented",
   "alternatives": [
    {
     "alt": "analytic power",
     "criterion": "a closed-form power function exists"
    },
    {
     "alt": "simulation-based power",
     "criterion": "the test is complex or the design is non-standard"
    },
    {
     "alt": "bootstrap size correction",
     "criterion": "the test over-rejects and you want a corrected critical value"
    }
   ],
   "output_key_fields": [
    "size: rejection frequency under the null, which should equal alpha",
    "power: rejection frequency under each alternative",
    "size_corrected_power: power at the empirical rather than nominal critical value",
    "mc_se: Monte Carlo standard error of each frequency"
   ],
   "chart_kind": "multi-line",
   "interpretation_traps": [
    "comparing POWER between tests that do not have the same size is meaningless -- size-corrected power is the only fair comparison",
    "every reported frequency has Monte Carlo error; with 1000 replications a 5% rate has a standard error near 0.7 percentage points",
    "a test that over-rejects under the null will look powerful under the alternative for exactly the wrong reason"
   ],
   "sources": [
    "Davidson & MacKinnon 2004, Econometric Theory and Methods, ch.4",
    "Horowitz 2001, The bootstrap (Handbook of Econometrics 5)"
   ],
   "precondition_tools": null,
   "precondition_gates": null,
   "validation_notes": null
  },
  {
   "id": 311,
   "method": "Coverage and calibration checks",
   "wrapper_file": "c36_monte_carlo_design/coverage_calibration.py",
   "tool_fns": [
    "mc_coverage_study",
    "mc_pit"
   ],
   "when": "an interval or a predictive distribution claims a coverage level, and that claim should be checked rather than assumed",
   "when_not": "the procedure is exact by construction, such as a randomisation interval in a finite design",
   "alternatives": [
    {
     "alt": "coverage simulation",
     "criterion": "you have a known truth to cover"
    },
    {
     "alt": "PIT histogram",
     "criterion": "the object is a predictive distribution rather than an interval"
    },
    {
     "alt": "calibration curve",
     "criterion": "the object is a probability forecast"
    }
   ],
   "output_key_fields": [
    "coverage: realised coverage per nominal level",
    "coverage_error: realised minus nominal, with its Monte Carlo error",
    "mean_width: interval width, since coverage alone can be bought with width",
    "pit: probability-integral-transform values, uniform under correct calibration"
   ],
   "chart_kind": "table",
   "interpretation_traps": [
    "coverage and width must be read TOGETHER; a trivially wide interval covers perfectly and says nothing",
    "an under-covering interval is a bigger problem than a wide one, because it makes false claims rather than weak ones",
    "PIT uniformity is necessary but not sufficient for calibration -- a badly wrong forecast can still be marginally calibrated"
   ],
   "sources": [
    "Dawid 1984 (JRSS-A 147:278)",
    "Gneiting, Balabdaoui & Raftery 2007 (JRSS-B 69:243-268)",
    "scipy.stats"
   ],
   "precondition_tools": null,
   "precondition_gates": null,
   "validation_notes": null
  },
  {
   "id": 312,
   "method": "Global sensitivity analysis: Sobol, Morris, FAST and delta",
   "wrapper_file": "c36_monte_carlo_design/global_sensitivity.py",
   "tool_fns": [
    "mc_sobol",
    "mc_morris",
    "mc_sample_design"
   ],
   "when": "a model has many inputs and you want to know which ones actually drive the output, over the whole input space rather than at one point",
   "when_not": "the model is cheap and linear, where local derivatives suffice; there are only one or two inputs",
   "alternatives": [
    {
     "alt": "Morris screening",
     "criterion": "many inputs and you only need to rank them cheaply"
    },
    {
     "alt": "Sobol indices",
     "criterion": "you want variance shares including interactions"
    },
    {
     "alt": "local sensitivity",
     "criterion": "the model is near-linear around one point"
    }
   ],
   "output_key_fields": [
    "first_order: the variance share attributable to each input alone",
    "total_order: the share including every interaction the input takes part in",
    "interaction: total minus first order, which is where the structure hides",
    "conf_int: bootstrap intervals on each index"
   ],
   "chart_kind": "table",
   "interpretation_traps": [
    "a LOCAL derivative is not a global sensitivity; for a nonlinear model the two routinely disagree about which input matters",
    "first-order indices summing to well below one means interactions dominate -- read the total-order indices, not the first-order ones",
    "Sobol needs a specific sample design; feeding it an arbitrary sample gives numbers that are not Sobol indices"
   ],
   "sources": [
    "Sobol 2001 (Mathematics and Computers in Simulation 55:271)",
    "Morris 1991 (Technometrics 33:161)",
    "Saltelli et al. 2008, Global Sensitivity Analysis: The Primer",
    "SALib"
   ],
   "precondition_tools": null,
   "precondition_gates": null,
   "validation_notes": null
  },
  {
   "id": 313,
   "method": "Experimental designs: Latin hypercube, factorial, Box-Behnken and Plackett-Burman",
   "wrapper_file": "c36_monte_carlo_design/experimental_designs.py",
   "tool_fns": [
    "mc_design_generate"
   ],
   "when": "choosing WHERE to evaluate an expensive model or run an experiment, so the runs you can afford answer the question",
   "when_not": "the input space is one dimensional; you can afford to evaluate everywhere",
   "alternatives": [
    {
     "alt": "Latin hypercube",
     "criterion": "continuous inputs and a space-filling sample"
    },
    {
     "alt": "full factorial",
     "criterion": "few discrete factors and you want every combination"
    },
    {
     "alt": "Plackett-Burman",
     "criterion": "many factors, screening main effects only"
    }
   ],
   "output_key_fields": [
    "design: the generated design matrix",
    "n_runs: how many evaluations the design costs",
    "resolution: which effects are confounded with which, for fractional designs",
    "discrepancy: space-filling quality for the sampling designs"
   ],
   "chart_kind": "table",
   "interpretation_traps": [
    "a fractional factorial CONFOUNDS effects by construction; the resolution says which, and ignoring it means attributing an interaction to a main effect",
    "Plackett-Burman screens main effects only and its interaction aliasing is complex -- it is a screen, not an analysis",
    "Latin hypercube is space-filling in projection but a bad draw can still cluster; check the discrepancy"
   ],
   "sources": [
    "Box & Behnken 1960 (Technometrics 2:455)",
    "Plackett & Burman 1946 (Biometrika 33:305-325)",
    "McKay, Beckman & Conover 1979 (Technometrics 21:239)",
    "pyDOE3"
   ],
   "precondition_tools": null,
   "precondition_gates": null,
   "validation_notes": null
  },
  {
   "id": 314,
   "method": "Power analysis and minimum detectable effect for randomised and cluster designs",
   "wrapper_file": "c36_monte_carlo_design/power_analysis.py",
   "tool_fns": [
    "mc_power",
    "mc_power_cluster"
   ],
   "when": "deciding how large a trial must be before running it, or reporting honestly what a completed trial could ever have detected",
   "when_not": "the study is already run and you are tempted by post-hoc power, which is a function of the p-value and adds nothing",
   "alternatives": [
    {
     "alt": "analytic power",
     "criterion": "a standard two-arm design"
    },
    {
     "alt": "cluster-adjusted power",
     "criterion": "randomisation is at group level"
    },
    {
     "alt": "simulation-based power",
     "criterion": "the design is non-standard"
    }
   ],
   "output_key_fields": [
    "n_required: sample size for the requested power",
    "power: attained power at a given size and effect",
    "mde: the minimum detectable effect at the design's size",
    "design_effect: the cluster inflation factor, 1 + (m-1)*icc"
   ],
   "chart_kind": "table",
   "interpretation_traps": [
    "POST-HOC power computed from the observed effect is a monotone function of the p-value and tells you nothing -- do not report it",
    "cluster randomisation inflates the required sample by the design effect; ignoring the intra-cluster correlation understates the needed size by a large multiple",
    "the number of CLUSTERS, not the number of individuals, drives power in a cluster design"
   ],
   "sources": [
    "Cohen 1988, Statistical Power Analysis for the Behavioral Sciences, 2nd ed.",
    "Duflo, Glennerster & Kremer 2007, Using randomization in development economics research (Handbook of Development Economics 4)",
    "statsmodels.stats.power"
   ],
   "precondition_tools": null,
   "precondition_gates": null,
   "validation_notes": null
  },
  {
   "id": 315,
   "method": "Quasi-random and low-discrepancy sequences",
   "wrapper_file": "c36_monte_carlo_design/quasi_random.py",
   "tool_fns": [
    "mc_qmc_sample",
    "mc_discrepancy"
   ],
   "when": "Monte Carlo integration converges slowly; a low-discrepancy sequence fills the space more evenly and converges faster for smooth integrands",
   "when_not": "the integrand is discontinuous or very high dimensional, where the advantage disappears; you need genuine randomness for a randomisation test",
   "alternatives": [
    {
     "alt": "plain pseudo-random",
     "criterion": "you need independence, as in a randomisation test"
    },
    {
     "alt": "Sobol sequence",
     "criterion": "smooth integrand, moderate dimension"
    },
    {
     "alt": "scrambled sequences",
     "criterion": "you want quasi-random accuracy plus an error estimate"
    }
   ],
   "output_key_fields": [
    "sample: the generated points",
    "discrepancy: how evenly the points fill the space",
    "scrambled: whether randomisation was applied, which is what permits an error estimate"
   ],
   "chart_kind": "table",
   "interpretation_traps": [
    "an UNSCRAMBLED low-discrepancy sequence gives no error estimate at all, because the points are deterministic",
    "the advantage decays with dimension and is usually gone well before a hundred dimensions",
    "taking a non-power-of-two prefix of a Sobol sequence breaks its balance properties"
   ],
   "sources": [
    "Niederreiter 1992, Random Number Generation and Quasi-Monte Carlo Methods",
    "Owen 1997 (Annals of Statistics 25:1541)",
    "scipy.stats.qmc"
   ],
   "precondition_tools": null,
   "precondition_gates": null,
   "validation_notes": null
  }
 ],
