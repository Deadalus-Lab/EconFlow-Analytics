{
 "category": "41-credit-risk-default",
 "cards": [
  {
   "id": 347,
   "method": "Merton structural model: distance to default and implied default probability",
   "wrapper_file": "c41_credit_risk_default/merton_structural.py",
   "tool_fns": [
    "cr_distance_to_default",
    "cr_merton_pd"
   ],
   "when": "inferring a firm's default risk from its equity market value and its liabilities, using the option analogy rather than a rating",
   "when_not": "the firm is unlisted so there is no equity price; the capital structure is too complex for a single default barrier",
   "alternatives": [
    {
     "alt": "reduced-form hazard models",
     "criterion": "you have default histories and covariates"
    },
    {
     "alt": "credit scorecards",
     "criterion": "the obligor is a retail borrower"
    },
    {
     "alt": "rating transition matrices",
     "criterion": "ratings are available and sufficient"
    }
   ],
   "output_key_fields": [
    "distance_to_default: standardised distance from the barrier",
    "implied_pd: the model default probability",
    "asset_value, asset_volatility: the recovered unobservables",
    "converged: whether the simultaneous system solved"
   ],
   "chart_kind": "table",
   "interpretation_traps": [
    "asset value and asset volatility are NOT observed; they are solved from a two-equation system, and non-convergence produces plausible-looking numbers",
    "the model PD is risk-neutral and is systematically higher than the physical default rate",
    "distance to default is far more useful as a RANKING than as a level; the calibrated probability depends heavily on the barrier definition"
   ],
   "sources": [
    "Merton 1974 (Journal of Finance 29:449-470)",
    "Crosbie & Bohn 2003, Modeling default risk (Moody's KMV)",
    "Bharath & Shumway 2008 (Review of Financial Studies 21:1339)",
    "DOI 10.1111/j.1540-6261.1974.tb03058.x"
   ],
   "precondition_tools": null,
   "precondition_gates": null,
   "validation_notes": null
  },
  {
   "id": 348,
   "method": "Rating and state transition matrices, generators and long-run behaviour",
   "wrapper_file": "c41_credit_risk_default/transition_matrices.py",
   "tool_fns": [
    "cr_transition_matrix",
    "cr_generator",
    "cr_stationary_distribution"
   ],
   "when": "summarising migration between rating or risk states, and projecting it forward to a multi-period or continuous-time horizon",
   "when_not": "there are no discrete states; the sample has too few migrations for the off-diagonal cells to be estimated",
   "alternatives": [
    {
     "alt": "cohort estimator",
     "criterion": "simple, uses period-end states only"
    },
    {
     "alt": "duration (hazard) estimator",
     "criterion": "uses the exact timing of every migration and is far more efficient"
    },
    {
     "alt": "generator matrix",
     "criterion": "you need continuous-time or non-integer horizons"
    }
   ],
   "output_key_fields": [
    "transition_matrix: the estimated migration probabilities",
    "generator: the continuous-time generator, where one exists",
    "stationary_distribution: the long-run state shares",
    "embeddability: whether a valid generator exists at all"
   ],
   "chart_kind": "heatmap",
   "interpretation_traps": [
    "a discrete transition matrix need not have a valid GENERATOR -- the embedding problem -- and forcing one produces negative off-diagonal rates",
    "the cohort estimator discards within-period migrations and understates volatility of ratings; the duration estimator does not",
    "sparse off-diagonal cells give zero estimated probabilities for rare but important transitions, which then propagate to zero multi-period risk"
   ],
   "sources": [
    "Jarrow, Lando & Turnbull 1997 (Review of Financial Studies 10:481-523)",
    "Lando & Skodeberg 2002 (Journal of Banking and Finance 26:423)",
    "Israel, Rosenthal & Wei 2001 (Mathematical Finance 11:245)",
    "statsmodels"
   ],
   "precondition_tools": null,
   "precondition_gates": null,
   "validation_notes": null
  },
  {
   "id": 349,
   "method": "Credit scorecards: optimal binning, weight of evidence and monotonic constraints",
   "wrapper_file": "c41_credit_risk_default/scorecards.py",
   "tool_fns": [
    "cr_optimal_binning",
    "cr_woe_transform",
    "cr_scorecard"
   ],
   "when": "building a transparent, monotone, regulator-defensible credit score from borrower characteristics",
   "when_not": "interpretability is not required and pure predictive power is the only objective; the default count is too small for binning to be stable",
   "alternatives": [
    {
     "alt": "gradient boosting",
     "criterion": "prediction matters more than explanation"
    },
    {
     "alt": "plain logistic regression",
     "criterion": "no binning wanted and relationships are near-linear"
    },
    {
     "alt": "optimal binning with monotone constraints",
     "criterion": "a scorecard that must be explained and signed off"
    }
   ],
   "output_key_fields": [
    "bins: the selected cut points per variable",
    "woe, iv: weight of evidence per bin and information value per variable",
    "scorecard: points per attribute",
    "monotonic: whether each variable's default rate is monotone in its bins"
   ],
   "chart_kind": "table",
   "interpretation_traps": [
    "INFORMATION VALUE is a univariate screen; a variable with high IV can be useless after controlling for another, and one with low IV can matter",
    "binning on the full sample and then validating on part of it leaks information -- bins must be fitted on the training split only",
    "weight of evidence is undefined for a bin with no defaults or no non-defaults; the smoothing used to avoid that changes the score"
   ],
   "sources": [
    "Siddiqi 2017, Intelligent Credit Scoring, 2nd ed.",
    "Thomas, Edelman & Crook 2002, Credit Scoring and Its Applications",
    "optbinning"
   ],
   "precondition_tools": null,
   "precondition_gates": null,
   "validation_notes": null
  },
  {
   "id": 350,
   "method": "Probability-of-default calibration, discrimination and reliability",
   "wrapper_file": "c41_credit_risk_default/pd_calibration.py",
   "tool_fns": [
    "cr_discrimination",
    "cr_calibration",
    "cr_grade_test"
   ],
   "when": "checking that a credit model both RANKS obligors correctly and produces probabilities at the right level -- two different requirements",
   "when_not": "the model output is a score with no probability interpretation and none is wanted",
   "alternatives": [
    {
     "alt": "AUC / Gini / KS",
     "criterion": "discrimination -- can the model rank"
    },
    {
     "alt": "calibration curve and Brier decomposition",
     "criterion": "level -- are the probabilities right"
    },
    {
     "alt": "Hosmer-Lemeshow",
     "criterion": "a formal calibration test, though it is sensitive to binning"
    }
   ],
   "output_key_fields": [
    "auc, gini, ks: discrimination measures",
    "calibration_curve: predicted against realised default rate by bucket",
    "brier, reliability, resolution: the Brier decomposition",
    "binomial_test: per-grade test that the realised rate matches the assigned PD"
   ],
   "chart_kind": "line",
   "interpretation_traps": [
    "DISCRIMINATION AND CALIBRATION ARE INDEPENDENT: a model can rank perfectly (AUC 1.0) while every probability is wrong by a factor of ten",
    "a model calibrated on a benign period is systematically under-calibrated in a downturn; through-the-cycle and point-in-time PDs are different objects",
    "Hosmer-Lemeshow depends on the number of groups chosen and can be made to pass or fail by that choice"
   ],
   "sources": [
    "Hosmer & Lemeshow 2000, Applied Logistic Regression, 2nd ed.",
    "Murphy 1973 (Journal of Applied Meteorology 12:595-600)",
    "Basel Committee 2005, Studies on the validation of internal rating systems (Working Paper 14)"
   ],
   "precondition_tools": null,
   "precondition_gates": null,
   "validation_notes": null
  },
  {
   "id": 351,
   "method": "Loss given default and exposure at default models",
   "wrapper_file": "c41_credit_risk_default/lgd_ead.py",
   "tool_fns": [
    "cr_lgd_model",
    "cr_ead_model"
   ],
   "when": "modelling the other two components of expected loss, whose distributions are bounded, bimodal and badly served by ordinary regression",
   "when_not": "recovery data is absent and a regulatory floor is being applied instead",
   "alternatives": [
    {
     "alt": "beta regression",
     "criterion": "the outcome is a proportion strictly inside the unit interval"
    },
    {
     "alt": "fractional response",
     "criterion": "the outcome includes exact zeros and ones"
    },
    {
     "alt": "two-part model",
     "criterion": "a mass at zero or one plus a continuous part"
    }
   ],
   "output_key_fields": [
    "params: coefficients on the chosen link",
    "fitted: predicted loss given default or credit conversion factor",
    "distribution_fit: how well the bounded distribution matches the observed shape",
    "downturn_lgd: the stressed value where a downturn indicator is supplied"
   ],
   "chart_kind": "table",
   "interpretation_traps": [
    "observed recovery is strongly BIMODAL -- clustered near zero and near one -- so a model fitting only the conditional mean misses the shape entirely",
    "linear regression on a bounded outcome predicts outside the unit interval, and truncating the prediction is not a fix",
    "downturn LGD is a regulatory concept requiring a stressed estimate; the through-the-cycle average is not it"
   ],
   "sources": [
    "Schuermann 2004, What do we know about loss given default? (Wharton Financial Institutions Center)",
    "Papke & Wooldridge 1996 (Journal of Applied Econometrics 11:619-632)",
    "Ferrari & Cribari-Neto 2004 (Journal of Applied Statistics 31:799)",
    "statsmodels"
   ],
   "precondition_tools": null,
   "precondition_gates": null,
   "validation_notes": null
  },
  {
   "id": 352,
   "method": "Time-to-default hazard models and lifetime PD term structures",
   "wrapper_file": "c41_credit_risk_default/lifetime_pd.py",
   "tool_fns": [
    "cr_lifetime_pd",
    "cr_pd_scenario"
   ],
   "when": "producing a PD for every future year rather than one year ahead -- the requirement behind lifetime expected credit loss",
   "when_not": "only a one-year PD is needed; the panel is too short for a term structure to be estimated rather than extrapolated",
   "alternatives": [
    {
     "alt": "one-year PD models",
     "criterion": "only the next year matters"
    },
    {
     "alt": "discrete-time hazard",
     "criterion": "the panel is annual and the natural model is a hazard"
    },
    {
     "alt": "transition-matrix projection",
     "criterion": "ratings are available and the matrix can be powered up"
    }
   ],
   "output_key_fields": [
    "marginal_pd: the default probability in each future period",
    "cumulative_pd: the survival-implied cumulative probability",
    "term_structure: the PD curve over the lifetime",
    "conditioning: how macroeconomic scenarios shifted the curve"
   ],
   "chart_kind": "multi-line",
   "interpretation_traps": [
    "cumulative PD is ONE MINUS the survival probability, not a sum of marginal PDs; adding them overstates lifetime risk and the error compounds with horizon",
    "extrapolating a term structure beyond the observed panel is an assumption about duration dependence, and it dominates long-horizon loss",
    "point-in-time conditioning on macro scenarios makes the curve move procyclically, which is the intent but also a source of volatility in reported loss"
   ],
   "sources": [
    "Lando 2004, Credit Risk Modeling: Theory and Applications",
    "Bellotti & Crook 2013 (International Journal of Forecasting 29:563-574)",
    "lifelines"
   ],
   "precondition_tools": null,
   "precondition_gates": null,
   "validation_notes": null
  },
  {
   "id": 353,
   "method": "Portfolio credit loss distribution: Vasicek single- and multi-factor and Monte Carlo",
   "wrapper_file": "c41_credit_risk_default/portfolio_credit_loss.py",
   "tool_fns": [
    "cr_vasicek_loss",
    "cr_credit_monte_carlo",
    "cr_concentration"
   ],
   "when": "aggregating obligor-level risk into a portfolio loss distribution, where correlation rather than average PD drives the tail",
   "when_not": "the portfolio is a single exposure; correlations cannot be estimated or assumed with any credibility",
   "alternatives": [
    {
     "alt": "Vasicek single factor",
     "criterion": "the regulatory closed form, one systematic factor"
    },
    {
     "alt": "multi-factor Monte Carlo",
     "criterion": "sector or geographic concentration matters"
    },
    {
     "alt": "saddlepoint approximation",
     "criterion": "you want tail accuracy without full simulation"
    }
   ],
   "output_key_fields": [
    "loss_distribution: the simulated or analytic distribution",
    "expected_loss, unexpected_loss: mean and standard deviation",
    "var, es: tail measures at the requested level",
    "concentration: the share of tail loss attributable to the largest exposures"
   ],
   "chart_kind": "line",
   "interpretation_traps": [
    "the ASSET CORRELATION drives the tail far more than the average PD does; a small change in correlation moves capital by a large multiple",
    "the single-factor model assumes an infinitely granular portfolio -- with concentrated exposures it understates the tail badly",
    "simulated tail quantiles at 99.9% need very many draws; the reported figure has Monte Carlo error that is rarely reported with it"
   ],
   "sources": [
    "Vasicek 2002 (Risk 15:160)",
    "Gordy 2003 (Journal of Financial Intermediation 12:199-232)",
    "Basel Committee 2006, International Convergence of Capital Measurement and Capital Standards"
   ],
   "precondition_tools": null,
   "precondition_gates": null,
   "validation_notes": null
  }
 ],
